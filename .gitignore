# cloning — no training required.
checkpoints/
!checkpoints/
checkpoints/*
!checkpoints/best.pt
logs/
*.ckpt
*.pth

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Agent workspace (local notes/memory — never part of the code history)
.workbuddy/
